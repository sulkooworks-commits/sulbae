async function pushStateToGitHub() {
  const token = document.getElementById('gh-token-input').value.trim();
  const owner = document.getElementById('gh-owner-input').value.trim();
  const repo = document.getElementById('gh-repo-input').value.trim();
  const statusEl = document.getElementById('sync-status');
  
  if (!token) { alert('GitHub Token을 입력해주세요.'); return; }
  localStorage.setItem('gh_sync_token', token);
  statusEl.className = "text-center text-xs font-bold text-slate-400";
  statusEl.innerText = "깃허브로 동기화 중...";

  const stateData = {
    updatedAt: new Date().toISOString(),
    fuelRecords: window.fuelRecords || [],
    customCosts: {
      hotel: document.getElementById('cost-hotel') ? document.getElementById('cost-hotel').value : 2940,
      flight: document.getElementById('cost-flight') ? document.getElementById('cost-flight').value : 2800,
      car: document.getElementById('cost-car') ? document.getElementById('cost-car').value : 940,
      etc: document.getElementById('cost-etc') ? document.getElementById('cost-etc').value : 130
    },
    storage: { ...localStorage }
  };

  const path = 'trip/data/state.json';
  const url = 'https://api.github.com/repos/' + owner + '/' + repo + '/contents/' + path;
  
  try {
    let sha = null;
    const getRes = await fetch(url, { headers: { Authorization: 'Bearer ' + token, Accept: 'application/vnd.github+json' } });
    if (getRes.ok) { 
      const fileInfo = await getRes.json(); 
      sha = fileInfo.sha; 
    }

    const jsonString = JSON.stringify(stateData, null, 2);
    // 한글 깨짐 방지를 위한 UTF-8 Base64 인코딩
    const contentB64 = btoa(unescape(encodeURIComponent(jsonString)));

    const putRes = await fetch(url, {
      method: 'PUT',
      headers: { 
        Authorization: 'Bearer ' + token, 
        'Content-Type': 'application/json',
        Accept: 'application/vnd.github+json'
      },
      body: JSON.stringify({ 
        message: 'Update trip state via dashboard sync', 
        content: contentB64, 
        sha: sha || undefined 
      })
    });

    if (putRes.ok) {
      statusEl.className = "text-center text-xs font-bold text-emerald-600";
      statusEl.innerText = "✓ 깃허브 동기화 성공! (/trip/data/state.json)";
    } else {
      const errJson = await putRes.json();
      console.error(errJson);
      statusEl.className = "text-center text-xs font-bold text-rose-600";
      statusEl.innerText = "✗ 실패: Contents 권한(Read and write)을 확인하세요.";
    }
  } catch (err) {
    console.error(err);
    statusEl.className = "text-center text-xs font-bold text-rose-600";
    statusEl.innerText = "✗ 네트워크 오류 발생";
  }
}
